# Optional model connection. Never commit keys. Model ID must match your provider.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
# Optional speech transcription model at MODEL_BASE_URL/audio/transcriptions.
ASR_MODEL=whisper-1
# Optional absolute path to edge-tts. Defaults to .local/voice-env/bin/edge-tts.
CUTFLOW_TTS_BIN=
# Default real local renderer. remotion also supported after Chromium installation.
RENDERER=ffmpeg
PORT=4318
