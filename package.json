{
  "name": "cutflow-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "share": "tsx server/share.ts",
    "test": "tsx --test tests/*.test.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/bundler": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "remotion": "4.0.529",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "zod": "^3.25.76",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.468.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.6"
  }
}
